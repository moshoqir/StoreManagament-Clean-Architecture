@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>403 Error | Paces Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap & App CSS -->
    <link href="~/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/vendors.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />
</head>

<body>
    <div class="position-absolute top-0 end-0">
        <img src="~/assets/images/auth-card-bg.svg" class="auth-card-bg-img" alt="bg" />
    </div>
    <div class="position-absolute bottom-0 start-0" style="transform: rotate(180deg)">
        <img src="~/assets/images/auth-card-bg.svg" class="auth-card-bg-img" alt="bg" />
    </div>
    <div class="auth-box overflow-hidden align-items-center d-flex">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xxl-5 col-md-6 col-sm-8">
                    <div class="card p-4">
                        <div class="auth-brand text-center mb-2">
                            <a href="/" class="logo-dark">
                                <img src="~/assets/images/logo-black.png" alt="dark logo" height="28" />
                            </a>
                        </div>

                        <div class="p-4 text-center">
                            <div class="error-text-alt fs-72 text-danger">403</div>
                            <h3 class="fw-bold text-uppercase">Permission Required</h3>
                            <p class="text-muted fs-5">
                                You don’t have the required permissions to view this page.
                                <br />
                                Please contact your administrator or try a different account.
                            </p>

                            <div class="mt-4 d-flex justify-content-center gap-1">
                                <!-- Sends them back to the root to evaluate their permissions again -->
                                <button class="btn btn-primary" onclick="window.location.href = '/'">Go to Dashboard</button>
                                <!-- Uses the Logout function successfully now -->
                                <button class="btn btn-outline-secondary" onclick="Logout()">
                                    Login with another account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Vendor js -->
    <script src="~/assets/js/vendors.min.js"></script>
    <script src="~/assets/js/app.js"></script>

    <!-- Guaranteed to load with the Razor ~/ path resolution -->
    <script src="/common/common.js"></script>
</body>
</html>